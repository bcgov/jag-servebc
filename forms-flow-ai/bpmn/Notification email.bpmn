<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_0e3v6wh" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="4.8.1">
  <bpmn:process id="EmailNotificationProcess" name="Email Notification" isExecutable="true">
    <bpmn:extensionElements>
      <camunda:properties>
        <camunda:property />
      </camunda:properties>
    </bpmn:extensionElements>
    <bpmn:endEvent id="EndNotificationEndEvent" name="End Notification">
      <bpmn:extensionElements>
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="javascript">var system = java.lang.System;
system.out.println("******#########EMAIL Response : " + email_response);</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1o80ruh</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="NotificationRequestStartEvent" name="Notification Request">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="category" type="string" />
        </camunda:formData>
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="javascript">var system=java.lang.System;
system.out.println(new Date().toLocaleDateString() + " ::" + applicationId + ":: " + "Started Notification Email Process");</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:outgoing>SequenceFlow_01shpg1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0o7ax3m" messageRef="Message_1ap8yc0" />
    </bpmn:startEvent>
    <bpmn:businessRuleTask id="EmailTemplateTask" name="Email Template" camunda:resultVariable="template" camunda:decisionRef="decide-email-template" camunda:mapDecisionResult="singleResult">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="category">${category}</camunda:inputParameter>
        </camunda:inputOutput>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="javascript">var system=java.lang.System;
system.out.println(new Date().toLocaleDateString() + " ::" + applicationId + ":: " + "DMN Result received:" + template);

system.out.println("**** "  + new Date().toLocaleDateString() + " ::" +applicationId + " Email Subject selected: " + execution.getVariable("template").get("subject"));</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0gv8qf7</bpmn:incoming>
      <bpmn:outgoing>Flow_0br2jt8</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="SequenceFlow_01shpg1" sourceRef="NotificationRequestStartEvent" targetRef="Activity_1wz1yf5" />
    <bpmn:serviceTask id="GetOAuthTokenTask" name="Get OAuth Token">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">
              <camunda:script scriptFormat="javascript">var system=java.lang.System;
var emailKcUrl=system.getenv('EMAIL_KEYCLOAK_URL');
emailKcUrl;</camunda:script>
            </camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/x-www-form-urlencoded</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="payload">
              <camunda:script scriptFormat="javascript">var system=java.lang.System;
var clientSecret= system.getenv('EMAIL_KEYCLOAK_CLIENT_SECRET');
var clientId=system.getenv('EMAIL_KEYCLOAK_CLIENT_ID');
var mypayload = ""; mypayload=mypayload.concat("grant_type=client_credentials&amp;client_id=",clientId,"&amp;client_secret=",clientSecret);
mypayload;

</camunda:script>
            </camunda:inputParameter>
            <camunda:outputParameter name="token">${S(response).prop("access_token").value()}</camunda:outputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="javascript">var system=java.lang.System;
system.out.println(new Date().toLocaleDateString() + " ::" + applicationId + ":: " + "OAuth Token :" + token);
</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0br2jt8</bpmn:incoming>
      <bpmn:outgoing>Flow_14n17ln</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_14n17ln" sourceRef="GetOAuthTokenTask" targetRef="InvokeEmailApiTask" />
    <bpmn:serviceTask id="InvokeEmailApiTask" name="Invoke email api">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="payload">
              <camunda:script scriptFormat="javascript">var payload = {};
payload.from = execution.getVariable("template").get("from");
payload.to = "[" + contactEmail + "]";
payload.bcc = "[" + execution.getVariable("template").get("bcc") + "]";
payload.bodyType = "html";
payload.body = email_body_formatted;
payload.subject = execution.getVariable("template").get("subject");
payload.delayTS = "0";
payload.encoding = "utf-8";
payload.priority = "normal";
payload.tag = "SL-" + applicationId +"-" + Date.now();

var payloadStr = JSON.stringify(payload);
payloadStr = payloadStr.replace("\"[","[\"").replace("\"[","[\"");
payloadStr=payloadStr.replace ("]\"","\"]").replace ("]\"","\"]");

var system = java.lang.System;
system.out.println("******#########EMAIL API Request :" + payloadStr );
payloadStr; </camunda:script>
            </camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="accept">application/json</camunda:entry>
                <camunda:entry key="Access-Control-Allow-Origin">*</camunda:entry>
                <camunda:entry key="Authorization">Bearer ${token}</camunda:entry>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="url">
              <camunda:script scriptFormat="javascript">var system=java.lang.System;
var myurl = system.getenv("EMAIL_SVC_URL");
myurl;</camunda:script>
            </camunda:inputParameter>
            <camunda:outputParameter name="email_response">${response}</camunda:outputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="javascript">var system=java.lang.System;
system.out.println(new Date().toLocaleDateString() + " ::" + applicationId + ":: " + "Tag :" + "SL-" + applicationId +"-" + Date.now());</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_14n17ln</bpmn:incoming>
      <bpmn:outgoing>Flow_1o80ruh</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1o80ruh" sourceRef="InvokeEmailApiTask" targetRef="EndNotificationEndEvent" />
    <bpmn:sequenceFlow id="Flow_0gv8qf7" sourceRef="Activity_1wz1yf5" targetRef="EmailTemplateTask" />
    <bpmn:businessRuleTask id="Activity_1wz1yf5" name="Document Type Mapping" camunda:resultVariable="docType" camunda:decisionRef="servebc-documenttype-mapping" camunda:mapDecisionResult="singleResult">
      <bpmn:extensionElements>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="javascript">execution.setVariable("documentType",execution.getVariable("docType").get("documentType"));
</camunda:script>
        </camunda:executionListener>
        <camunda:inputOutput>
          <camunda:inputParameter name="docTypeCode">${docTypeCode}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>SequenceFlow_01shpg1</bpmn:incoming>
      <bpmn:outgoing>Flow_0gv8qf7</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_0br2jt8" sourceRef="EmailTemplateTask" targetRef="GetOAuthTokenTask">
      <bpmn:extensionElements>
        <camunda:executionListener class="org.camunda.bpm.extension.hooks.listeners.execution.EmailAttributesListener" event="take" />
        <camunda:executionListener event="take">
          <camunda:script scriptFormat="javascript">var system=java.lang.System;
system.out.println(new Date().toLocaleDateString() + " ::" + applicationId + ":: " + "setting up email_body_formatted ");
</camunda:script>
        </camunda:executionListener>
        <camunda:executionListener event="take">
          <camunda:script scriptFormat="javascript">var system=java.lang.System;
system.out.println(new Date().toLocaleDateString() + " ::" + applicationId + ":: " + "email_body:" + email_body);

var tempHTML = Java.type("org.jsoup.Jsoup")
    .parse(email_body)
    .text(); 

var email_body_formatted= email_body.replace(/\\"/g, '"');
execution.setVariable("email_body_formatted", email_body_formatted);


system.out.println(new Date().toLocaleDateString() + " ::" + applicationId + ":: " + "email_body_formatted :" + email_body_formatted);</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmn:message id="Message_1ap8yc0" name="message-email-servebc" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="EmailNotificationProcess">
      <bpmndi:BPMNEdge id="Flow_0br2jt8_di" bpmnElement="Flow_0br2jt8">
        <di:waypoint x="420" y="117" />
        <di:waypoint x="620" y="117" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow_01shpg1_di" bpmnElement="SequenceFlow_01shpg1">
        <di:waypoint x="158" y="117" />
        <di:waypoint x="190" y="117" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_0gv8qf7_di" bpmnElement="Flow_0gv8qf7">
        <di:waypoint x="290" y="117" />
        <di:waypoint x="320" y="117" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1o80ruh_di" bpmnElement="Flow_1o80ruh">
        <di:waypoint x="880" y="117" />
        <di:waypoint x="952" y="117" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_14n17ln_di" bpmnElement="Flow_14n17ln">
        <di:waypoint x="720" y="117" />
        <di:waypoint x="780" y="117" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="StartEvent_1qc25qm_di" bpmnElement="NotificationRequestStartEvent">
        <dc:Bounds x="122" y="99" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="113" y="142" width="55" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_1a6wgpn_di" bpmnElement="Activity_1wz1yf5">
        <dc:Bounds x="190" y="77" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BusinessRuleTask_02kbmdk_di" bpmnElement="EmailTemplateTask">
        <dc:Bounds x="320" y="77" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_0k4s884_di" bpmnElement="EndNotificationEndEvent">
        <dc:Bounds x="952" y="99" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="931" y="142" width="78" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_1lxtect_di" bpmnElement="GetOAuthTokenTask">
        <dc:Bounds x="620" y="77" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_1rniyh0_di" bpmnElement="InvokeEmailApiTask">
        <dc:Bounds x="780" y="77" width="100" height="80" />
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
