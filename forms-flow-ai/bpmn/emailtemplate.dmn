          <text>"&lt;!DOCTYPE html&gt;
            &lt;html style="margin: 0; padding: 0; box-sizing: border-box; border: none"&gt;
              &lt;head style="margin: 0; padding: 0; box-sizing: border-box; border: none"&gt;
                &lt;meta
                  charset="utf-8"
                  style="margin: 0; padding: 0; box-sizing: border-box; border: none"
                /&gt;
