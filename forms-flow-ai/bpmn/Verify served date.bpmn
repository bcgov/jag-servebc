<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_0tvt410" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="4.8.1" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.15.0">
  <bpmn:process id="VerifyServedDateProcess" name="Verify served date" isExecutable="true">
    <bpmn:startEvent id="StartStartEvent" name="Start">
      <bpmn:extensionElements>
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="javascript">var payload = execution.getVariable('container');
var payloadObj = (typeof payload === "string") ? JSON.parse(payload) : payload;
var contactEmail = payloadObj.contactEmail || "";

execution.setVariable('contactEmail', contactEmail);

var Logger = Java.type("org.slf4j.LoggerFactory");
var logger = Logger.getLogger("BPMN_SCRIPT");
var timestamp = new java.util.Date().toString();

logger.debug("*********[Verify Served Date] {} :: {} ::   Verify Served Date Process Started", timestamp, applicationId);</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:outgoing>flow_start_to_gateway</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow_start_to_gateway" sourceRef="StartStartEvent" targetRef="Gateway_1tqoyzf" />
    <bpmn:businessRuleTask id="CheckForHolidayTask" name="Check for holiday" camunda:resultVariable="daytype" camunda:decisionRef="holidays-key" camunda:mapDecisionResult="singleEntry">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="datesubmitted">
            <camunda:script scriptFormat="javascript">var tempdate = new Date(receiveddate);
var tempdatestring = tempdate.getFullYear() + "-" + 
                     ("0" + (tempdate.getMonth() + 1)).slice(-2) + "-" + 
                     ("0" + tempdate.getDate()).slice(-2);

var logger = Java.type("org.slf4j.LoggerFactory").getLogger("BPMN_SCRIPT");
var timestamp = new java.util.Date().toString();
logger.info("********* {} :: {} :: Updated datesubmitted - {}", timestamp, applicationId, tempdatestring);

tempdatestring;</camunda:script>
          </camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_gateway_to_checkforholiday</bpmn:incoming>
      <bpmn:outgoing>flow_checkforholiday_to_checkforweektype</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="flow_checkforholiday_to_checkforweektype" sourceRef="CheckForHolidayTask" targetRef="CheckForWeekTypeTask">
      <bpmn:extensionElements>
        <camunda:executionListener event="take">
          <camunda:script scriptFormat="javascript">var tempdate = new Date(receiveddate);
var inputhour = tempdate.getHours() + (tempdate.getMinutes() / 60) + (tempdate.getSeconds() / 3600);
execution.setVariable('daynumber', tempdate.getDay());
execution.setVariable('inputhour', inputhour);

var logger = Java.type("org.slf4j.LoggerFactory").getLogger("BPMN_SCRIPT");
var timestamp = new java.util.Date().toString();

logger.debug("********* {} :: {} :: daytype - {}", timestamp, applicationId, daytype);
logger.debug("********* {} :: {} :: daynumber for weektype check - {}", timestamp, applicationId, daynumber);
logger.debug("********* {} :: {} :: inputhour for weektype check - {}", timestamp, applicationId, inputhour);</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:businessRuleTask id="CheckForWeekTypeTask" name="Check for week type" camunda:resultVariable="weektype" camunda:decisionRef="weektype-key" camunda:mapDecisionResult="singleEntry">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="inputhour">${inputhour}</camunda:inputParameter>
          <camunda:inputParameter name="daynumber">${daynumber}</camunda:inputParameter>
        </camunda:inputOutput>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="javascript">var system=java.lang.System;
var payload = execution.getVariable('container');
var payloadObj = JSON.parse(payload);

var contactEmail="";
if (payloadObj.contactEmail){
contactEmail=payloadObj.contactEmail;
}

execution.setVariable('contactEmail',contactEmail);</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_checkforholiday_to_checkforweektype</bpmn:incoming>
      <bpmn:outgoing>flow_checkforweektype_to_gateway</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="WorkingDayGateway" name="working day?">
      <bpmn:incoming>flow_checkforweektype_to_gateway</bpmn:incoming>
      <bpmn:outgoing>WorkingTimeSequenceFlow</bpmn:outgoing>
      <bpmn:outgoing>OutOfOfficeHoursSequenceFlow</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_checkforweektype_to_gateway" sourceRef="CheckForWeekTypeTask" targetRef="WorkingDayGateway">
      <bpmn:extensionElements>
        <camunda:executionListener event="take">
          <camunda:script scriptFormat="javascript">var system = java.lang.System;
system.out.println( " "+ new Date() + " : weektype in Check for weektype-" + weektype);</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:task id="SendServedEmailTask" name="Send Served Email">
      <bpmn:extensionElements>
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="javascript">var logger = Java.type("org.slf4j.LoggerFactory").getLogger("BPMN_SCRIPT");
var timestamp = new java.util.Date().toString();
logger.info("********* {} :: {} :: Sending Served Email since it is '{}' and '{}' on {}", timestamp, applicationId, daytype,weektype,receiveddate);</camunda:script>
        </camunda:executionListener>
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="javascript">execution.setVariable('applicationStatus', 'Only Served Email sent. No further processing done');

execution.setVariable('servedDate', new Date().toLocaleString());

execution.setVariable('serveDateInISOFormat', new Date().toISOString());</camunda:script>
        </camunda:executionListener>
        <camunda:executionListener expression="${execution.getProcessEngineServices().getRuntimeService().createMessageCorrelation(&#34;message-email-servebc&#34;).setVariable(&#34;category&#34;, &#34;served_email&#34;).setVariable(&#34;contactEmail&#34;,contactEmail).setVariable(&#34;docTypeCode&#34;,documentType).setVariable(&#34;applicationId&#34;,applicationId).correlateWithResult()}" event="end" />
      </bpmn:extensionElements>
      <bpmn:incoming>WorkingTimeSequenceFlow</bpmn:incoming>
      <bpmn:incoming>flow_sleep_to_sendservedemail</bpmn:incoming>
      <bpmn:outgoing>flow_sendservedemail_to_saveprocessdata</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="WorkingTimeSequenceFlow" name="working time" sourceRef="WorkingDayGateway" targetRef="SendServedEmailTask">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${execution.getVariable('daytype') == "workday" &amp;&amp; execution.getVariable('weektype') == "weekday"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="OutOfOfficeHoursSequenceFlow" name="Out of office hours" sourceRef="WorkingDayGateway" targetRef="NextWorkingDayTask">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${execution.getVariable('daytype') == "holiday" || execution.getVariable('weektype') != "weekday"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="EndEndEvent" name="end">
      <bpmn:extensionElements>
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="javascript">var Logger = Java.type("org.slf4j.LoggerFactory");
var logger = Logger.getLogger("BPMN_SCRIPT");
var timestamp = new java.util.Date().toString();

logger.debug("*********[Verify Served Date] {} :: {} ::   Verify Served Date Process Completed", timestamp, applicationId);</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_notify_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_sendservedemail_to_saveprocessdata" sourceRef="SendServedEmailTask" targetRef="SaveProcessDataCallActivity" />
    <bpmn:businessRuleTask id="NextWorkingDayTask" name="next working day" camunda:resultVariable="result" camunda:decisionRef="nextworkingday-key" camunda:mapDecisionResult="singleResult">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="weekday">${execution.getVariable('weektype')}</camunda:inputParameter>
          <camunda:inputParameter name="workday">${execution.getVariable('daytype')}</camunda:inputParameter>
          <camunda:outputParameter name="updated">${result.updated}</camunda:outputParameter>
          <camunda:outputParameter name="daystoadd">${result.daystoadd}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>OutOfOfficeHoursSequenceFlow</bpmn:incoming>
      <bpmn:outgoing>flow_nextworkingday_to_gateway</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="WorkingDayIdentifiedGateway" name="Working Day identified ?">
      <bpmn:incoming>flow_nextworkingday_to_gateway</bpmn:incoming>
      <bpmn:outgoing>NoSequenceFlow</bpmn:outgoing>
      <bpmn:outgoing>YesSequenceFlow</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_nextworkingday_to_gateway" sourceRef="NextWorkingDayTask" targetRef="WorkingDayIdentifiedGateway">
      <bpmn:extensionElements>
        <camunda:executionListener event="take">
          <camunda:script scriptFormat="javascript">var logger = Java.type("org.slf4j.LoggerFactory").getLogger("BPMN_SCRIPT");
var timestamp = new java.util.Date().toString();

llogger.debug("*********[Verify Served Date] {} :: {} :: Updated in next working day - {}", timestamp, applicationId, updated);
logger.debug("*********[Verify Served Date] {} :: {} :: DaysToAdd in next working day - {}", timestamp, applicationId, daystoadd);

var reviseDate = new Date(receiveddate);
logger.debug("*********[Verify Served Date] {} :: {} :: Revised date before change - {}", timestamp, applicationId, reviseDate);

reviseDate.setDate(reviseDate.getDate() + parseInt(daystoadd));
execution.setVariable('receiveddate', reviseDate.toLocaleString());
logger.debug("*********[Verify Served Date] {} :: {} :: Revised date after change - {}", timestamp, applicationId, reviseDate);
</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="NoSequenceFlow" name="No" sourceRef="WorkingDayIdentifiedGateway" targetRef="Gateway_1tqoyzf">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${execution.getVariable('updated') == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="YesSequenceFlow" name="Yes" sourceRef="WorkingDayIdentifiedGateway" targetRef="WaitForBusinessDayEvent">
      <bpmn:extensionElements>
        <camunda:executionListener event="take">
          <camunda:script scriptFormat="javascript">var iso = new Date(receiveddate).toISOString();
execution.setVariable('timerDate',iso);</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${execution.getVariable('updated')==false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:intermediateCatchEvent id="WaitForBusinessDayEvent" name="Wait for Business Day">
      <bpmn:extensionElements>
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="javascript">var logger = Java.type("org.slf4j.LoggerFactory").getLogger("BPMN_SCRIPT");
var timestamp = new java.util.Date().toString();

logger.debug("*********[Verify Served Date] {} :: {} :: Inside Wait Timer Task", timestamp, applicationId);</camunda:script>
        </camunda:executionListener>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="javascript">var logger = Java.type("org.slf4j.LoggerFactory").getLogger("BPMN_SCRIPT");
var timestamp = new java.util.Date().toString();

logger.debug("*********[Verify Served Date] {} :: {} :: End Wait Timer Task", timestamp, applicationId);</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>YesSequenceFlow</bpmn:incoming>
      <bpmn:outgoing>flow_sleep_to_sendservedemail</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_1f5zmd3">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">${timerDate}</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="flow_sleep_to_sendservedemail" sourceRef="WaitForBusinessDayEvent" targetRef="SendServedEmailTask" />
    <bpmn:callActivity id="SaveProcessDataCallActivity" name="Save process data" calledElement="SaveRequestDataProcess">
      <bpmn:documentation>(1) Call Subprocess to update document submission in central db
(2) set the http method to be used for API call (Listener)</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:in variables="all" />
        <camunda:out variables="all" />
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="javascript">execution.setVariable('method','PUT');

var Logger = Java.type("org.slf4j.LoggerFactory");
var logger = Logger.getLogger("BPMN_SCRIPT");
var timestamp = new java.util.Date().toString();
logger.debug("*********[Verify Served Data] {} :: {} ::  Saving Request Data", timestamp, applicationId);</camunda:script>
        </camunda:executionListener>
        <camunda:inputOutput>
          <camunda:inputParameter name="container">
            <camunda:script scriptFormat="javascript">var payload = execution.getVariable('container');
var payloadObj = JSON.parse(payload);
payloadObj.servedDate= new Date().toISOString();

//setting this to sync with form
execution.setVariable('servedDate',payloadObj.servedDate);

var payloadStr = JSON.stringify(payloadObj);
var system = java.lang.System;
system.out.println("******** Updated Request with servedDate inside VerifyServedDateProcess: - " + payloadStr);
payloadStr;</camunda:script>
          </camunda:inputParameter>
        </camunda:inputOutput>
        <camunda:executionListener class="org.camunda.bpm.extension.hooks.listeners.ApplicationStateListener" event="start" />
        <camunda:executionListener class="org.camunda.bpm.extension.hooks.listeners.BPMFormDataPipelineListener" event="start">
          <camunda:field name="fields">
            <camunda:expression>["applicationId", "applicationStatus"]</camunda:expression>
          </camunda:field>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_sendservedemail_to_saveprocessdata</bpmn:incoming>
      <bpmn:outgoing>flow_saveprocessdata_to_notify</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="flow_saveprocessdata_to_notify" sourceRef="SaveProcessDataCallActivity" targetRef="NotifyServedDateUpdateEvent" />
    <bpmn:sequenceFlow id="flow_notify_to_end" sourceRef="NotifyServedDateUpdateEvent" targetRef="EndEndEvent" />
    <bpmn:intermediateThrowEvent id="NotifyServedDateUpdateEvent" name="Notify Served Date Update">
      <bpmn:extensionElements>
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="javascript">var logger = Java.type("org.slf4j.LoggerFactory").getLogger("BPMN_SCRIPT");
var timestamp = new java.util.Date().toString();
logger.info("*********[Verify Served Date] {} :: {} :: Sending Signal - 'UpdateServedDate-{}'", timestamp, applicationId, applicationId);</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_saveprocessdata_to_notify</bpmn:incoming>
      <bpmn:outgoing>flow_notify_to_end</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SignalEventDefinition_1abby4d" signalRef="Signal_1daqonn" />
    </bpmn:intermediateThrowEvent>
    <bpmn:exclusiveGateway id="Gateway_1tqoyzf">
      <bpmn:incoming>flow_start_to_gateway</bpmn:incoming>
      <bpmn:incoming>NoSequenceFlow</bpmn:incoming>
      <bpmn:outgoing>flow_gateway_to_checkforholiday</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_gateway_to_checkforholiday" sourceRef="Gateway_1tqoyzf" targetRef="CheckForHolidayTask" />
  </bpmn:process>
  <bpmn:signal id="Signal_0e2hb40" name="UpdateServedDate" />
  <bpmn:message id="Message_0e6ph5m" name="UpdateServedDate-${applicationId}" />
  <bpmn:signal id="Signal_1daqonn" name="UpdateServedDate-${applicationId}" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
