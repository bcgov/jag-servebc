<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:biodi="http://bpmn.io/schema/dmn/biodi/2.0" id="Definitions_1h338s2" name="DRD" namespace="http://camunda.org/schema/1.0/dmn" exporter="Camunda Modeler" exporterVersion="4.8.1">
  <decision id="decide-email-template" name="email-template">
    <decisionTable id="decisionTable_1" hitPolicy="FIRST">
      <input id="input_1" label="category" biodi:width="150">
        <inputExpression id="inputExpression_1" typeRef="string">
          <text>category</text>
        </inputExpression>
      </input>
      <output id="output_2" label="from" name="from" typeRef="string" biodi:width="167" />
      <output id="output_1" label="to" name="to" typeRef="string" biodi:width="150" />
      <output id="OutputClause_0c48jer" label="cc" name="cc" typeRef="string" biodi:width="150" />
      <output id="OutputClause_1ux6lei" label="bcc" name="bcc" typeRef="string" biodi:width="150" />
      <output id="OutputClause_0h396nn" label="subject" name="subject" typeRef="string" biodi:width="150" />
      <output id="OutputClause_1o2aisg" label="body" name="body" typeRef="string" biodi:width="467" />
      <rule id="DecisionRule_0dps9ou">
        <inputEntry id="UnaryTests_0o0a1b2">
          <text>"served_email"</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1f01eue">
          <text>"DoNotReply &lt;Civil.Litigation@gov.bc.ca&gt;"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_0o595hq">
          <text>""</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_11u9z56">
          <text></text>
        </outputEntry>
        <outputEntry id="LiteralExpression_0y6w75c">
          <text>"aglsblitigationect@gov.bc.ca"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_12nz6nm">
          <text>"Document Submission Served"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_0ja9ppr">
          <text>"&lt;!DOCTYPE html&gt;&lt;html&gt;&lt;head&gt;&lt;meta charset=\"utf-8\"&gt;&lt;meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\"&gt;&lt;meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"&gt;&lt;style&gt;body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Oxygen,Ubuntu,Cantarell,'Open Sans','Helvetica Neue',sans-serif;color:#313132;margin:0;padding:0}p{margin-top:24px;margin-bottom:0}#Serve_Legal_Documents{font-weight:700;font-size:20px;color:rgba(0,51,102,1);letter-spacing:-.2px}#Congratulations{font-weight:700;font-size:16px;letter-spacing:-.2px;margin-bottom:32px}.link{font-size:16px;color:#1a5a96;text-decoration:underline;word-wrap:break-word}.link:hover{text-decoration:none;color:#00f}.info{font-size:16px;color:#313132;text-align:justify;line-height:24px}@media screen and (max-width:600px){table{width:100%!important}img{max-width:100%!important;height:auto!important}td{display:block;width:100%!important}}&lt;/style&gt;&lt;/head&gt;&lt;body&gt;&lt;table style=\"width:100%;max-width:750px;margin:0 auto\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"&gt;&lt;tr&gt;&lt;td style=\"width:151px;padding:10px\"&gt;&lt;img src=\"https://delightful-forest-018edef1e.azurestaticapps.net/img/BCID_H_rgb_pos_150.png\" style=\"max-width:100%;height:auto\" alt=\"BCID Logo\"&gt;&lt;/td&gt;&lt;td style=\"padding:10px\"&gt;&lt;span id=\"Serve_Legal_Documents\"&gt;Serve Legal Documents&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;table style=\"width:100%;max-width:750px;margin:0 auto\"&gt;&lt;tr&gt;&lt;td&gt;&lt;hr color=\"#DBDCDC\" size=\"1\"&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;table style=\"width:100%;max-width:750px;margin:0 auto\"&gt;&lt;tr&gt;&lt;td&gt;&lt;p id=\"Congratulations\"&gt;Your @documentType has been served on the Attorney General of British Columbia&lt;/p&gt;&lt;p class=\"info\"&gt;We confirm the @documentType you uploaded to Serve Legal Documents was served on the Attorney General of British Columbia today. If the document(s) you uploaded to Serve Legal Documents are not a Notice of Constitutional Question and any supporting documents, the document(s) have &lt;u&gt;&lt;b&gt;not&lt;/b&gt;&lt;/u&gt; been served.&lt;/p&gt;&lt;p class=\"info\"&gt;At this time, the Serve Legal Documents portal is &lt;u&gt;&lt;b&gt;not&lt;/b&gt;&lt;/u&gt; available to serve any documents except Notices of Constitutional Question and supporting documents. A list of options available to serve other types of documents is available &lt;a class=\"link\" href=\"https://www2.gov.bc.ca/gov/content/governments/organizational-structure/ministries-organizations/ministries/justice-attorney-general/ministry-contacts/serving-legal-documents\"&gt;here&lt;/a&gt;.&lt;/p&gt;&lt;p class=\"info\"&gt;If you have any questions, please contact us at&lt;a class=\"link\" href=\"mailto:aglsblitigationect@gov.bc.ca\"&gt;aglsblitigationect@gov.bc.ca&lt;/a&gt;.&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;table style=\"width:100%;max-width:750px;margin:0 auto\"&gt;&lt;tr&gt;&lt;td style=\"padding-top:24px\"&gt;&lt;hr color=\"#DBDCDC\" size=\"1\"&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/body&gt;&lt;/html&gt;"</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="DMNDiagram_02c261e">
      <dmndi:DMNShape id="DMNShape_0fxxwab" dmnElementRef="decide-email-template">
        <dc:Bounds height="80" width="180" x="150" y="150" />
      </dmndi:DMNShape>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
