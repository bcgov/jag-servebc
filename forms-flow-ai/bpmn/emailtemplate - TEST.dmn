<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:biodi="http://bpmn.io/schema/dmn/biodi/2.0" id="Definitions_1h338s2" name="DRD" namespace="http://camunda.org/schema/1.0/dmn" exporter="Camunda Modeler" exporterVersion="4.8.1">
  <decision id="decide-email-template" name="email-template">
    <decisionTable id="decisionTable_1" hitPolicy="FIRST">
      <input id="input_1" label="category" biodi:width="150">
        <inputExpression id="inputExpression_1" typeRef="string">
          <text>category</text>
        </inputExpression>
      </input>
      <output id="output_2" label="from" name="from" typeRef="string" biodi:width="167" />
      <output id="output_1" label="to" name="to" typeRef="string" biodi:width="150" />
      <output id="OutputClause_0c48jer" label="cc" name="cc" typeRef="string" biodi:width="150" />
      <output id="OutputClause_1ux6lei" label="bcc" name="bcc" typeRef="string" biodi:width="150" />
      <output id="OutputClause_0h396nn" label="subject" name="subject" typeRef="string" biodi:width="150" />
      <output id="OutputClause_1o2aisg" label="body" name="body" typeRef="string" biodi:width="467" />
      <rule id="DecisionRule_0dps9ou">
        <inputEntry id="UnaryTests_0o0a1b2">
          <text>"served_email"</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1f01eue">
          <text>"DoNotReply &lt;Civil.Litigation@gov.bc.ca&gt;"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_0o595hq">
          <text>""</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_11u9z56">
          <text></text>
        </outputEntry>
        <outputEntry id="LiteralExpression_0y6w75c">
          <text>"vinod@aot-technologies.com"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_12nz6nm">
          <text>"Document Submission Served (Test)"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_0ja9ppr">
          <text>"&lt;!DOCTYPE html&gt;
&lt;html lang=\"en\"&gt;&lt;head&gt;&lt;meta charset=\"utf-8\"&gt;&lt;meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"&gt;&lt;title&gt;Service Confirmation&lt;/title&gt;&lt;style&gt;body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;color:#313132;margin:0;padding:20px;background:#f5f5f5}.container{width:100%;max-width:600px;margin:0 auto;background:#fff;border-top:4px solid #003366;padding:30px}h1{font-size:20px;color:#003366;margin:0;display:inline-block;vertical-align:middle}.status-header{font-size:18px;font-weight:700;margin-top:30px}.content{font-size:16px;line-height:1.5;text-align:justify}.link{color:#1a5a96;text-decoration:underline}hr{border:0;border-top:1px solid #dbdcdc;margin:25px 0}@media screen and (max-width:480px){.container{padding:15px}.logo-cell{display:block;width:100%!important;text-align:center}}&lt;/style&gt;&lt;/head&gt;&lt;body&gt;&lt;div class=\"container\"&gt;&lt;table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"&gt;&lt;tr&gt;&lt;td class=\"logo-cell\" width=\"160\" style=\"vertical-align:middle\"&gt;&lt;img src=\"https://delightful-forest-018edef1e.azurestaticapps.net/img/BCID_H_rgb_pos_150.png\" width=\"150\" alt=\"BCID Logo\" style=\"display:block;border:0\"&gt;&lt;/td&gt;&lt;td class=\"logo-cell\" style=\"vertical-align:middle\"&gt;&lt;h1&gt;Serve Legal Documents&lt;/h1&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;hr&gt;&lt;div class=\"status-header\"&gt;Your @documentType has been served on the Attorney General of British Columbia&lt;/div&gt;&lt;p class=\"content\"&gt;We confirm the &lt;strong&gt;@documentType&lt;/strong&gt; you uploaded was served on the Attorney General of British Columbia today. If the document(s) uploaded are not a @documentType and any supporting documents, the document(s) have &lt;strong&gt;&lt;u&gt;not&lt;/u&gt;&lt;/strong&gt; been served.&lt;/p&gt;&lt;p class=\"content\"&gt;The Serve Legal Documents portal is &lt;strong&gt;&lt;u&gt;not&lt;/u&gt;&lt;/strong&gt; available to serve documents except those listed on its main page. Other options are available &lt;a class=\"link\" href=\"https://www2.gov.bc.ca/gov/content/governments/organizational-structure/ministries-organizations/ministries/justice-attorney-general/ministry-contacts/serving-legal-documents\"&gt;here&lt;/a&gt;.&lt;/p&gt;&lt;p class=\"content\"&gt;Questions? Contact us at &lt;a class=\"link\" href=\"mailto:aglsblitigationect@gov.bc.ca\"&gt;aglsblitigationect@gov.bc.ca&lt;/a&gt;&lt;/p&gt;&lt;hr&gt;&lt;/div&gt;&lt;/body&gt;&lt;/html&gt;"</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="DMNDiagram_02c261e">
      <dmndi:DMNShape id="DMNShape_0fxxwab" dmnElementRef="decide-email-template">
        <dc:Bounds height="80" width="180" x="150" y="150" />
      </dmndi:DMNShape>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
