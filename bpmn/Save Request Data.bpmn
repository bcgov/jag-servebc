        <dc:Bounds x="540" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_0dcosv7_di" bpmnElement="EndSaveEndEvent">
        <dc:Bounds x="692" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="688" y="145" width="45" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_1e9gs3w_di" bpmnElement="GetOAuthTokenTask">
        <dc:Bounds x="380" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_0kwkuzc" bpmnElement="copyFormData">
        <dc:Bounds x="230" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_0dbbj54_di" bpmnElement="flow_start_to_copyformdata">
        <di:waypoint x="178" y="120" />
        <di:waypoint x="230" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_091n8il_di" bpmnElement="flow_getauthtoken_to_invokeapi">
        <di:waypoint x="480" y="120" />
        <di:waypoint x="540" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_0suj7s2_di" bpmnElement="flow_invokeapi_to_end">
        <di:waypoint x="640" y="120" />
        <di:waypoint x="692" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1lgvyeb_di" bpmnElement="flow_copyformdata_to_getauthtoken">
        <di:waypoint x="330" y="120" />
        <di:waypoint x="380" y="120" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>