          <dc:Bounds x="853" y="93" width="32" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_1vbalmj_di" bpmnElement="DocumentStatusStaffGroupTask">
